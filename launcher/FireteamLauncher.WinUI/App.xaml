<Application
    x:Class="FireteamLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- FIRETEAM reuses the supplied Open1320 WinUI 3 launcher design language. -->
            <SolidColorBrush x:Key="LauncherBackgroundBrush" Color="#101112" />
            <SolidColorBrush x:Key="LauncherTitleBarBrush" Color="#0B0C0D" />
            <SolidColorBrush x:Key="LauncherPanelBrush" Color="#1A1C1E" />
            <SolidColorBrush x:Key="LauncherPanelRaisedBrush" Color="#222529" />
            <SolidColorBrush x:Key="LauncherInputBrush" Color="#292C30" />
            <SolidColorBrush x:Key="LauncherBorderBrush" Color="#34383D" />
            <SolidColorBrush x:Key="LauncherDividerBrush" Color="#4A4E53" />
            <SolidColorBrush x:Key="LauncherPrimaryTextBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="LauncherSecondaryTextBrush" Color="#A7ABB0" />
            <SolidColorBrush x:Key="LauncherMutedTextBrush" Color="#74797F" />
            <SolidColorBrush x:Key="LauncherGreenBrush" Color="#2ED44F" />
            <SolidColorBrush x:Key="LauncherCyanBrush" Color="#30BDE7" />
            <SolidColorBrush x:Key="LauncherWarningBrush" Color="#F2C14E" />
            <SolidColorBrush x:Key="LauncherDangerBrush" Color="#F05A5A" />

            <Style x:Key="LauncherCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource LauncherPanelBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LauncherBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="LauncherRaisedCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource LauncherPanelRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LauncherBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="14" />
            </Style>

            <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{StaticResource LauncherGreenBrush}" />
            </Style>

            <Style x:Key="HeroTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
                <Setter Property="FontSize" Value="40" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="20" />
                <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryTextBrush}" />
            </Style>

            <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
                <Setter Property="FontSize" Value="25" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryTextBrush}" />
            </Style>

            <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryTextBrush}" />
            </Style>

            <Style x:Key="FieldLabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource LauncherSecondaryTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PrimaryActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource LauncherGreenBrush}" />
                <Setter Property="Foreground" Value="#08100A" />
                <Setter Property="BorderBrush" Value="{StaticResource LauncherGreenBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="SecondaryActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource LauncherPanelRaisedBrush}" />
                <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LauncherDividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="LauncherTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource LauncherInputBrush}" />
                <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LauncherDividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="3" />
            </Style>

            <Style x:Key="LauncherComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource LauncherInputBrush}" />
                <Setter Property="Foreground" Value="{StaticResource LauncherPrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LauncherDividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="3" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
